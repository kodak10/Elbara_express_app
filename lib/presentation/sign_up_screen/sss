onTapSignup() async {
  if (_formKey.currentState!.validate()) {
    try {
      await FirebaseAuth.instance.verifyPhoneNumber(
        phoneNumber: controller.phoneNumberController.text,
        verificationCompleted: (PhoneAuthCredential credential) {
          // Cette fonction sera appelée automatiquement lorsque l'utilisateur
          // est vérifié sans avoir à entrer manuellement le code de vérification.
          // Vous pouvez gérer l'authentification ici si nécessaire.
        },
        verificationFailed: (FirebaseAuthException e) {
          // Gérer les erreurs de vérification ici, si nécessaire.
          print('Erreur de vérification: ${e.message}');
        },
        codeSent: (String verificationId, int? resendToken) async {
          // Naviguer vers ConfirmationPhoneScreen avec le ID de vérification
          Get.toNamed(
            AppRoutes.confirmationPhoneScreen,
            arguments: verificationId, // Passer le ID de vérification à ConfirmationPhoneScreen
          );
        },
        codeAutoRetrievalTimeout: (String verificationId) {
          // Cette fonction sera appelée lorsque le temps imparti pour la saisie automatique du code expirera.
          // Vous pouvez gérer cela si nécessaire.
        },
      );
    } catch (e) {
      print('Erreur lors de l'envoi du code de vérification: $e');
    }
  }
}
